# Leave OAuth fields empty until the company GitLab application is registered.
# Set all five values together; callback must be WEB_ORIGIN/api/auth/callback.
GITLAB_URL=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=
WEB_ORIGIN=

HOST=127.0.0.1
PORT=3001

# For a company internal CA, point Node to the PEM CA bundle before starting it.
# NODE_EXTRA_CA_CERTS=/path/to/company-ca.pem
# Git uses its own trust store; configure http.sslCAInfo or GIT_SSL_CAINFO as needed.
