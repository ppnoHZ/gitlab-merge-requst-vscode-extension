{
  "name": "@gitlab-workbench/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "scripts": {
    "build": "tsc -p . && esbuild src/index.ts --bundle --platform=neutral --format=esm --outfile=dist/index.js && esbuild src/index.ts --bundle --platform=neutral --format=cjs --outfile=dist/index.cjs",
    "compile": "tsc -p . --noEmit",
    "test": "esbuild test/core.test.ts --bundle --platform=node --format=esm --outfile=dist/core.test.mjs && node --test dist/core.test.mjs"
  }
}
